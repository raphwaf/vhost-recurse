#!/usr/bin/env bash
# vhost-recurse.sh - recursive virtual host brute forcing with ffuf
#
# Runs ffuf against one target with "Host: FUZZ.<domain>", collects every
# vhost it finds, then fuzzes each new vhost one level down
# ("FUZZ.<new-vhost>"), until a level finds nothing new or the max depth
# is reached.

set -uo pipefail

VERSION="1.3"

# ---------- defaults ----------
TARGET_URL=""
IP=""
DOMAIN=""
WORDLIST="/usr/share/seclists/Discovery/DNS/subdomains-top1million-5000.txt"
REC_WORDLIST=""   # wordlist for depth 2+ (default: same as -w)
PORT=""
SCHEME=""
MAX_DEPTH=2
THREADS=40
OUTDIR=""
ADD_HOSTS=0
FFUF_BIN="${FFUF_BIN:-ffuf}"
EXTRA_ARGS=()

# ---------- colors (off when not a terminal, or when NO_COLOR is set) ----------
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    C_RST=$'\e[0m';  C_BLD=$'\e[1m';  C_DIM=$'\e[2m'; C_ITL=$'\e[3m'
    C_RED=$'\e[38;5;203m'; C_GRN=$'\e[38;5;84m';  C_YLW=$'\e[38;5;221m'
    C_BLU=$'\e[38;5;75m';  C_MAG=$'\e[38;5;213m'; C_CYN=$'\e[38;5;51m'
    C_ORG=$'\e[38;5;215m'; C_GRY=$'\e[38;5;245m'; C_PRP=$'\e[38;5;141m'
else
    C_RST=""; C_BLD=""; C_DIM=""; C_ITL=""
    C_RED=""; C_GRN=""; C_YLW=""; C_BLU=""; C_MAG=""; C_CYN=""; C_ORG=""; C_GRY=""; C_PRP=""
fi

info() { printf '%s[*]%s %s\n' "$C_BLU" "$C_RST" "$*"; }
good() { printf '%s%s[+]%s %s\n' "$C_BLD" "$C_GRN" "$C_RST" "$*"; }
warn() { printf '%s%s[!]%s %s%s%s\n' "$C_BLD" "$C_YLW" "$C_RST" "$C_YLW" "$*" "$C_RST" >&2; }
die()  { printf '%s%s[-]%s %s%s%s\n' "$C_BLD" "$C_RED" "$C_RST" "$C_RED" "$*" "$C_RST" >&2; exit 1; }
kv()   { printf '%s[*]%s %s%-10s%s %s\n' "$C_BLU" "$C_RST" "$C_GRY" "$1" "$C_RST" "$2"; }

# Color an HTTP status code by class.
status_color() {
    case "$1" in
        2*) printf '%s' "$C_GRN" ;;
        3*) printf '%s' "$C_CYN" ;;
        4*) printf '%s' "$C_YLW" ;;
        5*) printf '%s' "$C_RED" ;;
        *)  printf '%s' "$C_GRY" ;;
    esac
}

banner() {
    [[ -n "$C_RST" ]] || { echo "vhost-recurse v${VERSION}"; return; }
    local colors=("$C_MAG" "$C_PRP" "$C_BLU" "$C_CYN" "$C_GRN") i=0 line
    while IFS= read -r line; do
        printf '%s%s%s%s\n' "$C_BLD" "${colors[i % ${#colors[@]}]}" "$line" "$C_RST"
        i=$((i + 1))
    done <<'ART'
       _               _
__   _| |__   ___  ___| |_      _ __ ___  ___ _   _ _ __ ___  ___
\ \ / / '_ \ / _ \/ __| __|____| '__/ _ \/ __| | | | '__/ __|/ _ \
 \ V /| | | | (_) \__ \ ||_____| | |  __/ (__| |_| | |  \__ \  __/
  \_/ |_| |_|\___/|___/\__|    |_|  \___|\___|\__,_|_|  |___/\___|
ART
    printf '  %s%srecursive vhost brute forcing with ffuf%s  %sv%s%s\n\n' \
        "$C_ITL" "$C_GRY" "$C_RST" "$C_DIM" "$VERSION" "$C_RST"
}

usage() {
    cat <<EOF
vhost-recurse.sh v${VERSION} - recursive vhost brute forcing with ffuf

Usage:
  $(basename "$0") -u <url> [options] [-- <extra ffuf args>]
  $(basename "$0") -i <ip> -d <domain> [-p <port>] [options] [-- <extra ffuf args>]

Target (either form):
  -u <url>        Target URL, like gobuster: http://inlanefreight.htb:41280
                  The hostname becomes the base domain and is resolved to an
                  IP (via /etc/hosts or DNS).
  -i <ip>         Target IP address
  -d <domain>     Base domain (e.g. academy.htb). Overrides the -u hostname.
  -p <port>       Port (default: from -u, else 80/443)
  -s <scheme>     http or https (default: from -u, else http)

Options:
  -w <wordlist>   Wordlist (default: $WORDLIST)
  -W <wordlist>   Smaller wordlist for depth 2 and deeper (default: same as -w).
                  Each vhost found costs one more full scan, so a big -w with
                  a small -W keeps the recursion fast.
  -D <depth>      Max recursion depth (default: $MAX_DEPTH)
                  depth 1 = FUZZ.<domain> only
                  depth 2 = also FUZZ.<found>.<domain>, and so on
  -t <threads>    ffuf threads (default: $THREADS)
  -o <dir>        Output directory (default: ./vhosts_<domain>_<timestamp>)
  -a              Add new vhosts to /etc/hosts (uses sudo if not root)
  -h              Show this help

Anything after "--" is passed straight to ffuf, e.g. to set your own filter:
  $(basename "$0") -u http://academy.htb:31337 -- -fs 986

Examples:
  $(basename "$0") -u http://inlanefreight.htb:41280 -t 100 \\
      -w /usr/share/seclists/Discovery/DNS/subdomains-top1million-110000.txt \\
      -W /usr/share/seclists/Discovery/DNS/subdomains-top1million-5000.txt
  $(basename "$0") -i 10.129.20.5 -d academy.htb -p 31337 -D 3 -a
EOF
}

# ---------- argument parsing ----------
while getopts ":u:i:d:w:W:p:s:D:t:o:ah" opt; do
    case "$opt" in
        u) TARGET_URL="$OPTARG" ;;
        i) IP="$OPTARG" ;;
        d) DOMAIN="${OPTARG,,}" ;;
        w) WORDLIST="$OPTARG" ;;
        W) REC_WORDLIST="$OPTARG" ;;
        p) PORT="$OPTARG" ;;
        s) SCHEME="${OPTARG,,}" ;;
        D) MAX_DEPTH="$OPTARG" ;;
        t) THREADS="$OPTARG" ;;
        o) OUTDIR="$OPTARG" ;;
        a) ADD_HOSTS=1 ;;
        h) usage; exit 0 ;;
        :) die "Option -$OPTARG needs a value (see -h)" ;;
        \?) die "Unknown option -$OPTARG (see -h)" ;;
    esac
done
shift $((OPTIND - 1))
if [[ "${1:-}" == "--" ]]; then shift; fi
EXTRA_ARGS=("$@")

# ---------- resolve the target ----------
is_ipv4() { [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; }

if [[ -n "$TARGET_URL" ]]; then
    re='^(https?)://([^/:]+)(:([0-9]+))?(/.*)?$'
    [[ "${TARGET_URL,,}" =~ $re ]] || die "Cannot parse URL: $TARGET_URL (expected http(s)://host[:port])"
    url_scheme="${BASH_REMATCH[1]}"
    url_host="${BASH_REMATCH[2]}"
    url_port="${BASH_REMATCH[4]}"
    [[ -z "$SCHEME" ]] && SCHEME="$url_scheme"
    [[ -z "$PORT" && -n "$url_port" ]] && PORT="$url_port"
    if is_ipv4 "$url_host"; then
        [[ -z "$IP" ]] && IP="$url_host"
    else
        [[ -z "$DOMAIN" ]] && DOMAIN="$url_host"
        if [[ -z "$IP" ]]; then
            IP="$(getent ahostsv4 "$url_host" 2>/dev/null | awk '{print $1; exit}')"
            [[ -n "$IP" ]] || die "Cannot resolve $url_host - add it to /etc/hosts or pass -i <ip>"
        fi
    fi
fi

# ---------- validation ----------
[[ -n "$IP" && -n "$DOMAIN" ]] || { usage; echo; die "Need a target: -u <url>, or -i <ip> and -d <domain>"; }
command -v "$FFUF_BIN" >/dev/null 2>&1 || die "ffuf not found (install it or set FFUF_BIN=/path/to/ffuf)"
command -v jq   >/dev/null 2>&1 || die "jq not found (apt install jq)"
command -v curl >/dev/null 2>&1 || die "curl not found (apt install curl)"
[[ -r "$WORDLIST" ]] || die "Wordlist not readable: $WORDLIST"
[[ -z "$REC_WORDLIST" ]] && REC_WORDLIST="$WORDLIST"
[[ -r "$REC_WORDLIST" ]] || die "Recursion wordlist not readable: $REC_WORDLIST"
[[ -z "$SCHEME" ]] && SCHEME="http"
[[ "$SCHEME" == "http" || "$SCHEME" == "https" ]] || die "Scheme must be http or https"
[[ "$MAX_DEPTH" =~ ^[1-9][0-9]*$ ]] || die "Depth must be a positive integer"
[[ "$THREADS" =~ ^[1-9][0-9]*$ ]] || die "Threads must be a positive integer"
DOMAIN="${DOMAIN%.}"

if [[ -z "$PORT" ]]; then
    [[ "$SCHEME" == "https" ]] && PORT=443 || PORT=80
fi
[[ "$PORT" =~ ^[0-9]+$ ]] || die "Port must be a number"

URL="${SCHEME}://${IP}:${PORT}/"
CURL_OPTS=(-s --noproxy '*' --max-time 10 -o /dev/null)
[[ "$SCHEME" == "https" ]] && CURL_OPTS+=(-k)

# A user-supplied filter replaces our own calibration.
USER_FILTER=0
for a in "${EXTRA_ARGS[@]}"; do
    case "$a" in
        -fs|-fw|-fl|-fc|-fr|-ft|-ac|-acc|-ach|-acs) USER_FILTER=1 ;;
    esac
done

if [[ -z "$OUTDIR" ]]; then
    OUTDIR="./vhosts_${DOMAIN}_$(date +%Y%m%d_%H%M%S)"
fi
mkdir -p "$OUTDIR/raw" || die "Cannot create output directory: $OUTDIR"

FOUND_FILE="$OUTDIR/vhosts.txt"
HOSTS_FILE="$OUTDIR/hosts_entries.txt"
: > "$FOUND_FILE"
WORDS="$(grep -c '' "$WORDLIST")"
REC_WORDS="$(grep -c '' "$REC_WORDLIST")"

# ---------- state ----------
declare -A SEEN=()          # every vhost already found (or the base domain)
SEEN["$DOMAIN"]=1
CURRENT_LEVEL=("$DOMAIN")   # domains to fuzz at this depth
ALL_FOUND=()

# ---------- connectivity check ----------
# ffuf reports a dead target as "0 results", which looks exactly like
# "no vhosts". Check up front so a wrong IP/port fails loudly.
preflight() {
    local code
    code="$(curl "${CURL_OPTS[@]}" -w '%{http_code}' -H "Host: ${DOMAIN}" "$URL" 2>/dev/null)"
    if [[ ! "$code" =~ ^[1-5][0-9][0-9]$ ]]; then
        die "Cannot connect to $URL - check the IP and port (is the target up?)"
    fi
    printf '%s[*]%s Target is up: %s%sHTTP %s%s for Host: %s%s%s\n' \
        "$C_BLU" "$C_RST" "$C_BLD" "$(status_color "$code")" "$code" "$C_RST" "$C_CYN" "$DOMAIN" "$C_RST"
}

# ---------- baseline calibration ----------
# Request a few random, non-existent vhosts under <base> and print the ffuf
# filter that hides that "default" response. We do this ourselves instead of
# ffuf's -ac, because -ac can mislabel a real hit under multiple threads.
calibrate() {
    local base="$1" sizes="" s i rnd
    for i in 1 2 3; do
        rnd="$(LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c 14)"
        s="$(curl "${CURL_OPTS[@]}" -w '%{size_download}' -H "Host: ${rnd}.${base}" "$URL" 2>/dev/null)" || s=""
        [[ "$s" =~ ^[0-9]+$ ]] || { echo "-ac"; return; }
        sizes+="$s"$'\n'
    done
    if [[ "$(printf '%s' "$sizes" | sort -u | wc -l)" -eq 1 ]]; then
        echo "-fs $(printf '%s' "$sizes" | head -n1)"
    else
        echo "-ac"   # dynamic baseline - fall back to ffuf's own calibration
    fi
}

# ---------- progress display ----------
# Reads ffuf's stderr (progress lines separated by \r), draws our own
# progress bar on the terminal, and records the final counters in a stats file.
progress_filter() {
    local stats="$1" log="$2" line clean
    local done_n=0 total=0 rate=0 dur="0:00:00" errs=0 pct filled bar empty bcol ecol
    local tty=0 frame=0
    [[ -t 2 ]] && tty=1
    local re='Progress: \[([0-9]+)/([0-9]+)\].* ([0-9]+) req/sec :: Duration: \[([0-9:]+)\] :: Errors: ([0-9]+)'
    local spin=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local width=40

    # The running man: 4 frames, 3 rows each, every row 3 columns wide.
    local run_head=(' o ' ' o ' ' o ' ' o ')
    local run_body=('/|\' '-|>' '\|/' '<|-')
    local run_legs=('/ >' ' |\' '< \' '/| ')
    local win_head='\o/' win_body=' | ' win_legs='/ \'
    local drawn=0 head body legs pos pad f

    while IFS= read -r -d $'\r' line || [[ -n "$line" ]]; do
        if [[ "$line" =~ $re ]]; then
            done_n="${BASH_REMATCH[1]}"; total="${BASH_REMATCH[2]}"
            rate="${BASH_REMATCH[3]}"; dur="${BASH_REMATCH[4]}"; errs="${BASH_REMATCH[5]}"
            if (( tty && total > 0 )); then
                pct=$(( done_n * 100 / total ))
                filled=$(( pct * width / 100 ))
                printf -v bar   '%*s' "$filled" '';            bar="${bar// /█}"
                printf -v empty '%*s' $(( width - filled )) ''; empty="${empty// /░}"
                if   (( pct < 34 )); then bcol="$C_MAG"
                elif (( pct < 67 )); then bcol="$C_PRP"
                else                      bcol="$C_CYN"; fi
                (( errs > 0 )) && ecol="$C_RED" || ecol="$C_GRY"

                # Pick the runner frame; he cheers when the bar is full.
                f=$(( frame % 4 ))
                if (( pct >= 100 )); then
                    head="$win_head"; body="$win_body"; legs="$win_legs"
                else
                    head="${run_head[f]}"; body="${run_body[f]}"; legs="${run_legs[f]}"
                fi
                # Keep him standing on the front edge of the filled part.
                pos=$(( filled - 2 )); (( pos < 0 )) && pos=0
                (( pos > width - 3 )) && pos=$(( width - 3 ))
                printf -v pad '%*s' $(( 6 + pos )) ''

                # Reserve 3 lines the first time, then move back up and redraw.
                if (( drawn )); then printf '\r\e[3A' >&2; else printf '\n\n\n\e[3A' >&2; drawn=1; fi
                printf '\r\e[2K%s%s%s%s%s\n' "$pad" "$C_BLD" "$C_ORG" "$head" "$C_RST" >&2
                printf '\r\e[2K%s%s%s%s%s\n' "$pad" "$C_BLD" "$C_ORG" "$body" "$C_RST" >&2
                printf '\r\e[2K%s%s%s%s%s\n' "$pad" "$C_BLD" "$C_ORG" "$legs" "$C_RST" >&2
                printf '\r\e[2K    %s%s%s %s%s%s%s%s %s%3d%%%s  %s%d/%d%s  %s%d req/s%s  %s%s%s  %serr %d%s' \
                    "$C_CYN" "${spin[frame % 10]}" "$C_RST" \
                    "$bcol" "$bar" "$C_GRY" "$empty" "$C_RST" \
                    "$C_BLD" "$pct" "$C_RST" \
                    "$C_GRY" "$done_n" "$total" "$C_RST" \
                    "$C_YLW" "$rate" "$C_RST" \
                    "$C_BLU" "$dur" "$C_RST" \
                    "$ecol" "$errs" "$C_RST" >&2
                frame=$((frame + 1))
            fi
        else
            clean="$(printf '%s' "$line" | sed 's/\x1b\[[0-9;]*[A-Za-z]//g')"
            [[ -n "${clean//[[:space:]]/}" ]] && printf '%s\n' "$clean" >> "$log"
        fi
    done
    # Wipe the runner and the bar, leaving the cursor where they started.
    if (( tty && drawn )); then
        printf '\r\e[2K\e[1A\e[2K\e[1A\e[2K\e[1A\e[2K' >&2
    elif (( tty )); then
        printf '\r\e[2K' >&2
    fi
    printf '%s %s %s %s\n' "$done_n" "$total" "$errs" "$dur" > "$stats"
}

# ---------- one ffuf run ----------
# Fuzz FUZZ.<base> and print the discovered full hostnames, one per line.
fuzz_level() {
    local base="$1" wordlist="$2"
    local json="$OUTDIR/raw/${base}.json"
    local log="$OUTDIR/raw/${base}.log"
    local stats="$OUTDIR/raw/${base}.stats"
    local filter=()

    if (( ! USER_FILTER )); then
        read -r -a filter <<< "$(calibrate "$base")"
        if [[ "${filter[0]}" == "-ac" ]]; then
            warn "Baseline for $base is not stable - using ffuf -ac (check results manually)"
        else
            printf '    %sbaseline:%s %s%s%s %s(default response)%s\n' \
                "$C_GRY" "$C_RST" "$C_ORG" "${filter[*]}" "$C_RST" "$C_DIM" "$C_RST" >&2
        fi
    fi

    local cmd=("$FFUF_BIN" -u "$URL" -H "Host: FUZZ.${base}" -w "$wordlist:FUZZ"
               -t "$THREADS" "${filter[@]}" -noninteractive
               -of json -o "$json" "${EXTRA_ARGS[@]}")
    printf 'Command: %s\n\n' "${cmd[*]}" > "$log"

    # ffuf: results -> stdout (log), progress -> stderr (our progress bar)
    { "${cmd[@]}" 2>&1 >>"$log"; } | progress_filter "$stats" "$log"
    local rc=${PIPESTATUS[0]}

    local done_n total errs dur
    read -r done_n total errs dur < "$stats" 2>/dev/null || { done_n=0; total=0; errs=0; dur="?"; }

    if [[ $rc -ne 0 || ! -s "$json" ]]; then
        warn "ffuf failed for FUZZ.${base} (see $log)"
        return 0
    fi
    if (( total > 0 && errs >= total )); then
        warn "All $total requests for FUZZ.${base} failed - target unreachable or blocking us"
    elif (( errs > 0 )); then
        warn "$errs of $total requests for FUZZ.${base} failed - some vhosts may be missed (try fewer threads: -t)"
    fi
    printf '    %s✓ %s requests in %s%s\n' "$C_GRY" "$total" "$dur" "$C_RST" >&2

    # Output: host <TAB> status <TAB> size <TAB> words
    jq -r --arg b "$base" \
        '.results[]? | [("\(.input.FUZZ).\($b)" | ascii_downcase), .status, .length, .words] | @tsv' \
        "$json" | sort -u -t$'\t' -k1,1
}

# ---------- /etc/hosts handling ----------
add_to_etc_hosts() {
    local host="$1"
    if grep -Eq "^[^#]*[[:space:]]${host//./\\.}([[:space:]]|$)" /etc/hosts 2>/dev/null; then
        info "Already in /etc/hosts: $host"
        return
    fi
    local line="$IP $host"
    if [[ $EUID -eq 0 ]]; then
        printf '%s\n' "$line" >> /etc/hosts
    else
        printf '%s\n' "$line" | sudo tee -a /etc/hosts >/dev/null
    fi && good "Added to /etc/hosts: $line" || warn "Could not write to /etc/hosts for $host"
}

# ---------- main loop ----------
banner
kv "Target"   "${C_CYN}${URL}${C_RST}  ${C_GRY}(Host: ${C_RST}${C_MAG}FUZZ${C_RST}${C_GRY}.${DOMAIN})${C_RST}"
kv "Wordlist" "$WORDLIST ${C_GRY}(${C_YLW}${WORDS}${C_GRY} words)${C_RST}"
if [[ "$REC_WORDLIST" != "$WORDLIST" ]]; then
    kv "Depth 2+" "$REC_WORDLIST ${C_GRY}(${C_YLW}${REC_WORDS}${C_GRY} words)${C_RST}"
fi
kv "Depth"    "${C_YLW}${MAX_DEPTH}${C_RST}   ${C_GRY}Threads:${C_RST} ${C_YLW}${THREADS}${C_RST}"
kv "Output"   "${C_DIM}${OUTDIR}${C_RST}"
preflight

declare -A INFO=()      # host -> "status size words" (for the summary)
declare -A PARENT=()    # host -> the base it was found under (for the tree)

depth=1
while (( depth <= MAX_DEPTH )) && (( ${#CURRENT_LEVEL[@]} > 0 )); do
    echo
    printf '%s%s━━━ Depth %d/%d %s%s· %d base(s) to fuzz %s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' \
        "$C_BLD" "$C_PRP" "$depth" "$MAX_DEPTH" "$C_RST" "$C_GRY" "${#CURRENT_LEVEL[@]}" "$C_PRP" "$C_RST"
    NEXT_LEVEL=()
    idx=0
    if (( depth == 1 )); then level_wl="$WORDLIST"; else level_wl="$REC_WORDLIST"; fi

    for base in "${CURRENT_LEVEL[@]}"; do
        idx=$((idx + 1))
        printf '%s[%d/%d]%s Fuzzing %s%sFUZZ%s.%s%s%s\n' "$C_GRY" "$idx" "${#CURRENT_LEVEL[@]}" "$C_RST" \
            "$C_BLD" "$C_MAG" "$C_RST" "$C_CYN" "$base" "$C_RST"
        new_here=0
        while IFS=$'\t' read -r host st sz wd; do
            [[ -z "$host" ]] && continue
            [[ -n "${SEEN[$host]:-}" ]] && continue
            SEEN["$host"]=1
            ALL_FOUND+=("$host")
            NEXT_LEVEL+=("$host")
            INFO["$host"]="$st $sz $wd"
            PARENT["$host"]="$base"
            printf '%s\n' "$host" >> "$FOUND_FILE"
            printf '    %s%s➜ FOUND%s  %s%-40s%s %s[%s]%s  %s%s B · %s words%s\n' \
                "$C_BLD" "$C_GRN" "$C_RST" "$C_BLD" "$host" "$C_RST" \
                "$(status_color "$st")" "$st" "$C_RST" "$C_GRY" "$sz" "$wd" "$C_RST"
            new_here=$((new_here + 1))
            (( ADD_HOSTS )) && add_to_etc_hosts "$host"
        done < <(fuzz_level "$base" "$level_wl")
        (( new_here == 0 )) && printf '    %s%s∅ nothing new under %s%s\n' "$C_DIM" "$C_GRY" "$base" "$C_RST"
    done

    if (( ${#NEXT_LEVEL[@]} == 0 )); then
        echo
        printf '%s[*]%s No new vhosts at depth %d - %sstopping%s.\n' "$C_BLU" "$C_RST" "$depth" "$C_GRN" "$C_RST"
        break
    fi
    CURRENT_LEVEL=("${NEXT_LEVEL[@]}")
    depth=$((depth + 1))
done

if (( depth > MAX_DEPTH )) && (( ${#CURRENT_LEVEL[@]} > 0 )); then
    echo
    warn "Reached max depth ($MAX_DEPTH). These were not fuzzed further:"
    printf "    ${C_ORG}%s${C_RST}\n" "${CURRENT_LEVEL[@]}" >&2
fi

# Print the found vhosts as a tree under the base domain.
print_tree() {
    local node="$1" prefix="$2" kids=() k i last branch next st sz wd
    for k in "${ALL_FOUND[@]}"; do
        [[ "${PARENT[$k]}" == "$node" ]] && kids+=("$k")
    done
    for i in "${!kids[@]}"; do
        k="${kids[i]}"
        last=$(( i == ${#kids[@]} - 1 ))
        (( last )) && branch="└── " || branch="├── "
        (( last )) && next="    "  || next="│   "
        read -r st sz wd <<< "${INFO[$k]}"
        printf '%s%s%s%s%s%s%s %s[%s]%s %s%s B%s\n' \
            "$C_GRY" "$prefix" "$branch" "$C_RST" "$C_BLD$C_GRN" "${k%.$node}" "$C_RST$C_GRY.$node$C_RST" \
            "$(status_color "$st")" "$st" "$C_RST" "$C_DIM" "$sz" "$C_RST"
        print_tree "$k" "$prefix$next"
    done
}

# ---------- summary ----------
echo
if (( ${#ALL_FOUND[@]} == 0 )); then
    warn "No vhosts found. Try a bigger wordlist (-w), or check the logs in $OUTDIR/raw/"
    exit 0
fi

printf '%s %s\n' "$IP" "$DOMAIN ${ALL_FOUND[*]}" > "$HOSTS_FILE"

